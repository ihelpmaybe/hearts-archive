{
  "name": "hearts-archive",
  "private": true,
  "version": "0.7.3",
  "description": "Heart’s Archive — on-chain newspaper for PulseChain (text stories + PLS A1 bids at 0x…feed)",
  "license": "UNLICENSED",
  "type": "module",
  "homepage": "https://github.com/ihelpmaybe/hearts-archive#readme",
  "bugs": {
    "url": "https://github.com/ihelpmaybe/hearts-archive/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihelpmaybe/hearts-archive.git"
  },
  "keywords": [
    "pulsechain",
    "newspaper",
    "web3",
    "dapp",
    "archive"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:desk": "vite",
    "dev:press": "vite --mode press",
    "build": "tsc --noEmit && vite build",
    "build:press": "tsc --noEmit && vite build",
    "build:desk": "tsc --noEmit && vite build --mode desk",
    "build:pages": "tsc --noEmit && vite build --base /hearts-archive/",
    "pack:press": "node scripts/pack-press.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node sim/smoke.mjs",
    "smoke:pages": "node scripts/pages-smoke.mjs",
    "check": "node scripts/check.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "sim": "node sim/run-sim.mjs",
    "sim:quick": "node sim/run-sim.mjs --users 100 --concurrency 20",
    "sim:lab": "node sim/lab.mjs",
    "sim:dry": "node sim/dry-run.mjs",
    "sim:front-spam": "node sim/front-spam.mjs",
    "sim:front-spam:quick": "node sim/front-spam.mjs --quick",
    "sim:seed": "node sim/seed-news.mjs",
    "mcp:themes": "node mcp-themes/server.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.17",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.6",
    "vitest": "^3.2.4"
  }
}
