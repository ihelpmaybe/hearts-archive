# Heart’s Archive — copy only if you need overrides.
# Desk vs Press is normally selected by npm script / start-press.*

# desk = develop (local publish, no wallet gate)
# press = people (Connect, chain Publish, Like, Tip, A1)
# VITE_ARCHIVE_FACE=press

# Optional Pulse RPC override (Press). Only URLs you trust.
# VITE_PULSE_RPC=https://rpc.pulsechain.com

# Lab fake posts (off by default). Prefer ?lab=1 when demoing.
# VITE_LAB_SEED=1
